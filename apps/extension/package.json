{
  "name": "@tazamun/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Tazamun browser extension for Chrome, Edge and Firefox.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome && wxt build -b edge && wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@tazamun/core": "workspace:*",
    "vue": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "fake-indexeddb": "^6.2.8",
    "vue-tsc": "^3.3.14",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
