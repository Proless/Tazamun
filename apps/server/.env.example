# Development settings for `pnpm --filter @tazamun/server dev`.
# Copy to apps/server/.env (git-ignored). Every setting: docs/guides/server-configuration.md
TAZAMUN_PUBLIC_URL=http://localhost:8080
TAZAMUN_DATA_DIR=./data-local
TAZAMUN_REGISTRATION=open
TAZAMUN_LOG_FORMAT=pretty
TAZAMUN_LOG_LEVEL=debug
