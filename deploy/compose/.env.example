# Settings for docker-compose.yml and docker-compose.caddy.yml. Copy to .env next to them.
# Every server setting: docs/guides/server-configuration.md

# The domain clients use to reach your server. With Caddy, point its DNS record at this machine.
TAZAMUN_DOMAIN=sync.example.org

# Who may create accounts: invite (one-time tokens from `tazamun invite create`), open or closed.
TAZAMUN_REGISTRATION=invite

# Storage per account, in MiB.
TAZAMUN_STORAGE_QUOTA_MB=200

# debug, info, warn or error.
TAZAMUN_LOG_LEVEL=info

# The image. Until 1.0 only `edge` (the latest main) exists; later, pin a version such as :1.2.
# TAZAMUN_IMAGE=ghcr.io/proless/tazamun:edge

# docker-compose.yml only: the loopback port your reverse proxy connects to.
# TAZAMUN_HOST_PORT=8080
